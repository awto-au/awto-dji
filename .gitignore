# Rust build artifacts
target/
**/target/

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# Dart/Flutter
.dart_tool/
.packages
build/

# Editor/OS
.DS_Store
*.swp
.vscode/

# Scratch / logs (never firmware images - those are DATA NOT IN THE REPO, see HANDOVER.md)
tmp/

# Large capture artifacts kept on disk for web/cloud agents to read, never committed
# (git history can't shrink back down once these are in it - see captures/README.md)
capture_local/

# Renode capture outputs (generated when running renode/scripts/*.resc)
m0900-capture.log
*-capture.txt
*-raw.txt
firmware/

# Public upstream source inputs used by the radio inventory, not vendored here.
sources/ad9361-reference/

# Downloaded APKs - DATA NOT IN THE REPO, see sources/README.md manifest
sources/**/*.apk

# Downloaded/extracted DJI FPGA firmware images - DATA NOT IN THE REPO,
# see sources/dji-fpga-images/PROVENANCE.md manifest
sources/dji-fpga-images/**/*.bin
sources/dji-fpga-images/**/*.zip

# Downloaded Lightbridge/drone RF IQ capture datasets - DATA NOT IN THE REPO,
# see sources/lightbridge-iq/PROVENANCE.md manifest
sources/lightbridge-iq/**/*.bin
sources/lightbridge-iq/**/*.zip
sources/lightbridge-iq/**/*.partial
# Standalone Lightbridge (IG800) firmware archives - DATA NOT IN THE REPO,
# see sources/lightbridge-ig800-firmware/PROVENANCE.md manifest
sources/lightbridge-ig800-firmware/**/*.zip
sources/lightbridge-ig800-firmware/*.zip
sources/lightbridge-ig800-firmware/*.tar.gz
sources/lightbridge-ig800-firmware/v1.4.8-decrypted/

# Exported chat transcripts: local only, may contain secrets/paths (see chats/README.md)
chats/*
!chats/README.md
!chats/2026-10-26-lightbridge-wimax-iq-investigation.md
