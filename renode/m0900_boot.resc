# Boot m0900 (Lightbridge air MCU) under Renode and capture its SPI traffic.
#
# Firmware is NOT in this repo (see HANDOVER.md "DATA NOT IN THE REPO") - pass it with
# $firmware set to an unpacked m0900.bin before including this script, e.g.:
#   $firmware=@/path/to/m0900.bin
#   include @renode/m0900_boot.resc
# Without $firmware this just loads the platform so the .repl can be checked.
# SPI captures land in $logPath (default tmp/logs/m0900-renode.log, workspace-relative) -
# grep for "AD9363Spy transaction" to pull just the register writes.

# Monitor scripts have no if/else - pass $firmware or leave it unset. If unset, the
# LoadBinary below fails with Renode's own "file not found", which is as clear as it gets.
$name?="m0900"
$firmware?=""
$logPath?=$ORIGIN/../tmp/logs/m0900-renode.log

logFile $logPath true
mach create $name

include $ORIGIN/peripherals/AD9363Spy.cs
machine LoadPlatformDescription $ORIGIN/platforms/m0900.repl

showAnalyzer sysbus.usart1

# STM32F103 boot ROM aliases flash to 0x0; m0900.bin is a raw dump (no vector-table
# relocation info), so load it at the flash base rather than LoadELF/LoadBinary-with-offset.
# CortexM reads SP/PC from the vector table at VectorTableOffset on reset - no manual PC.
sysbus LoadBinary $firmware 0x0
cpu VectorTableOffset 0x0
